# Live backend selection: auto | ddgs | searxng | brave | fixture
OFFICIAL_SEARCH_BACKEND=auto

# Optional independently configured discovery path for the tender reverse pass.
# It uses the same operator-owned SearXNG URL / Brave key / DDGS connector settings;
# the model cannot select or change it. Example: primary searxng, reverse brave.
# OFFICIAL_SEARCH_REVERSE_BACKEND=brave

# Engines used by the no-key DDGS fallback. These are search connectors, not an
# availability guarantee; production should prefer an operator-controlled SearXNG.
OFFICIAL_SEARCH_DDGS_BACKENDS=yahoo,duckduckgo,yandex

# Optional self-hosted SearXNG. The operator configures this endpoint; it is not
# model-controlled. JSON output must be enabled in SearXNG settings.yml.
# OFFICIAL_SEARCH_SEARXNG_URL=http://127.0.0.1:8080

# Optional Brave Search API backend. Never commit the real value.
# OFFICIAL_SEARCH_BRAVE_API_KEY=

# Comma-separated enterprise/organization domains explicitly approved by the operator.
# Government suffixes in the built-in policy do not need to be repeated.
# OFFICIAL_SEARCH_ALLOWED_DOMAINS=example.com

# Domains used when a tool call omits `domains`.
OFFICIAL_SEARCH_DEFAULT_DOMAINS=gov.cn,gov.hk,gov.mo

# Safer default: fetch_official_page only accepts URLs emitted by a recent search
# in the same process. Set true only when the host app separately proves that a URL
# came directly from a trusted user rather than from the model.
OFFICIAL_SEARCH_ALLOW_DIRECT_FETCH=false

# Hard safety/resource limits.
OFFICIAL_SEARCH_MAX_RESULTS=10
OFFICIAL_SEARCH_SEARCH_TIMEOUT_SECONDS=12
# Whole fixed 3-forward + 5-reverse tender workflow deadline.
OFFICIAL_SEARCH_TENDER_TIMEOUT_SECONDS=150
OFFICIAL_SEARCH_FETCH_TIMEOUT_SECONDS=15
OFFICIAL_SEARCH_MAX_RESPONSE_BYTES=2097152
OFFICIAL_SEARCH_MAX_CONTENT_CHARS=8000
OFFICIAL_SEARCH_MAX_REDIRECTS=3
OFFICIAL_SEARCH_MAX_CONCURRENCY=3
OFFICIAL_SEARCH_REQUESTS_PER_MINUTE=30
OFFICIAL_SEARCH_MIN_DOMAIN_INTERVAL_SECONDS=1.0

# Only needed by the explicit offline fixture backend.
# OFFICIAL_SEARCH_FIXTURE_PATH=/absolute/path/to/search_results.json
